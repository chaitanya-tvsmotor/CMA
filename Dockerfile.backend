FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Copy csproj files and restore dependencies
COPY ["src/CMA.API/CMA.API.csproj", "src/CMA.API/"]
COPY ["src/CMA.Application/CMA.Application.csproj", "src/CMA.Application/"]
COPY ["src/CMA.Domain/CMA.Domain.csproj", "src/CMA.Domain/"]
COPY ["src/CMA.Infrastructure/CMA.Infrastructure.csproj", "src/CMA.Infrastructure/"]

RUN dotnet restore "src/CMA.API/CMA.API.csproj"

# Copy everything else and build
COPY . .
WORKDIR "/src/src/CMA.API"
RUN dotnet build "CMA.API.csproj" -c Release -o /app/build

FROM build AS publish
RUN dotnet publish "CMA.API.csproj" -c Release -o /app/publish /p:UseAppHost=false

# Final stage
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app
EXPOSE 5000
EXPOSE 5001

COPY --from=publish /app/publish .

# Set environment variables
ENV ASPNETCORE_URLS=http://+:5000
ENV ASPNETCORE_ENVIRONMENT=Production

ENTRYPOINT ["dotnet", "CMA.API.dll"]
